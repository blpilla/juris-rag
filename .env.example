# Execução local. Em produção, use secrets manager e credenciais IAM.
POSTGRES_DB=jurisrag
POSTGRES_USER=jurisrag
POSTGRES_PASSWORD=jurisrag-local-only
APP_PORT=8080
REFERENCE_DATE=2026-11-01

# deterministic permite validar a demonstração sem baixar modelos. Use ollama para geração local.
AI_PROFILE=deterministic
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
